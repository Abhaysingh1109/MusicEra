# -----------------------------
# MusicEra backend environment
# -----------------------------

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# PostgreSQL (prefer DATABASE_URL in production)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=musicera
PGUSER=postgres
PGPASSWORD=change_me
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=false

# YouTube API
YOUTUBE_API_KEY=replace_with_your_key

# SMTP (OTP email)
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="MusicEra <your_email@gmail.com>"
SMTP_SKIP_VERIFY=false
SMTP_SEND_RETRIES=1

# OTP behavior
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEV_FALLBACK_ENABLED=true
OTP_ALLOW_PRODUCTION_DEV_FALLBACK=false

# Timeouts (ms)
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_VERIFY_TIMEOUT_MS=8000
OTP_MAIL_TIMEOUT_MS=12000
EMOTION_REQUEST_TIMEOUT_MS=6000
FACE_AUTH_REQUEST_TIMEOUT_MS=12000
FACE_AUTH_WORKER_STARTUP_TIMEOUT_MS=30000

# ML / Python
PYTHON_BIN=python3
ML_FEATURES_ENABLED=true
PYTHON_ISOLATED_ENV=false

# Search / recommendations
EMOTION_LOOKBACK_DAYS=3
FACE_MATCH_THRESHOLD=0.24
FACE_MATCH_FALLBACK_THRESHOLD=0.33
FACE_MATCH_MIN_MARGIN=0.015
PROFILE_PHOTO_MAX_BYTES=2097152
